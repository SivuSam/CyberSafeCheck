<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/checklistFragment">

    <fragment
        android:id="@+id/checklistFragment"
        android:name="com.csiq6823.cybersafecheck.ChecklistFragment"
        android:label="ChecklistFragment"
        tools:layout="@layout/fragment_checklist">

        <action
            android:id="@+id/show_risk_detail"
            app:destination="@id/riskDetailFragment" />

        <action
            android:id="@+id/show_score_dialog"
            app:destination="@id/scoreDialogFragment" />

        <action
            android:id="@+id/show_reset_confirmation"
            app:destination="@id/resetConfirmationDialogFragment" />

        <action
            android:id="@+id/show_history"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/riskDetailFragment"
        android:name="com.csiq6823.cybersafecheck.RiskDetailFragment"
        android:label="RiskDetailFragment"
        tools:layout="@layout/fragment_risk_detail">

        <argument
            android:name="riskItemId"
            app:argType="java.util.UUID" />
    </fragment>

    <dialog
        android:id="@+id/scoreDialogFragment"
        android:name="com.csiq6823.cybersafecheck.ScoreDialogFragment"
        android:label="ScoreDialogFragment">

        <argument
            android:name="flaggedCount"
            app:argType="integer" />

        <argument
            android:name="totalCount"
            app:argType="integer" />

        <argument
            android:name="breakdown"
            app:argType="string" />
    </dialog>

    <dialog
        android:id="@+id/resetConfirmationDialogFragment"
        android:name="com.csiq6823.cybersafecheck.ResetConfirmationDialogFragment"
        android:label="ResetConfirmationDialogFragment" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.csiq6823.cybersafecheck.HistoryFragment"
        android:label="HistoryFragment"
        tools:layout="@layout/fragment_history" />

</navigation>
